# Vercel Blob Storage token (needed for running sync-chromas script)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Vercel Blob base URL (enables fast chroma loading from Blob CDN)
# This is the "Base URL" shown on your Blob store page in the Vercel dashboard.
VITE_BLOB_BASE_URL=https://xxxxx.public.blob.vercel-storage.com

# Riot Developer API key (needed for match history on /dev page)
# Get one at https://developer.riotgames.com
# Use in Vercel: Project → Settings → Environment Variables → add RIOT_API_KEY
# For local dev with API routes: add to .env.local, then run "npm run dev:api" (port 3000)
# alongside "npm run dev". Or use "vercel dev" if you are logged into Vercel CLI.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
